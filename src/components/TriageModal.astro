---
// "Find your fight" — decision-tree modal that routes a dispute to a clause + template.
//
// CLAUSE_SLUGS is built server-side from CLAUSES so it can never drift
// from the data. Embedded as JSON below for the inline client script.
import { CLAUSES } from '../data/content';
const slugMap = Object.fromEntries(CLAUSES.map((c) => [c.n, c.slug]));
// Escape the two characters that could break out of a <script> tag — same
// pattern as JsonLd.astro. Trust source today (slugs are kebab-case
// constants in content.ts) but defence-in-depth costs nothing.
const slugMapJson = JSON.stringify(slugMap)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---
<dialog class="tb-triage" data-triage aria-label="Find your fight">
  <div class="tb-triage__panel">
    <div class="tb-triage__header">
      <div class="mono slash-label">Find your fight</div>
      <button type="button" class="kbd tb-triage__close" data-triage-close aria-label="Close (Escape)">ESC</button>
    </div>
    <div class="tb-triage__body" data-triage-body>
      <!-- Populated client-side -->
    </div>
  </div>
</dialog>
<script type="application/json" id="tb-clause-slugs" set:html={slugMapJson} />

<!-- is:global, not scoped: the body is built client-side with innerHTML, and
     those nodes never get Astro's data-astro-cid attribute, so scoped rules
     (gaps, option rows, result label) silently never matched them. Every
     selector here is .tb-triage-prefixed, so nothing leaks. -->
<style is:global>
  .tb-triage {
    /* Base <dialog> reset; keep native modal semantics but restyle */
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    max-width: none;
    max-height: none;
  }
  .tb-triage::backdrop {
    background: color-mix(in oklab, var(--ink) 70%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .tb-triage__panel {
    background: var(--paper);
    border: 1px solid var(--rule);
    width: min(640px, calc(100vw - 40px));
    max-height: calc(100vh - 40px);
    overflow: auto;
    padding: 28px 28px var(--space-6);
    border-radius: 2px;
    margin: 20px auto;
  }
  .tb-triage__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .tb-triage__close {
    cursor: pointer;
    padding: var(--space-1) var(--space-2);
  }
  .tb-triage__q {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    font-size: clamp(22px, 2.4vw, 30px);
    margin: 0 0 var(--space-5);
    max-width: 22ch;
  }
  .tb-triage__opts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .tb-triage__opt {
    text-align: left;
    padding: 14px var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .tb-triage__opt:hover {
    background: var(--paper-alt);
    border-color: var(--ink);
  }
  .tb-triage__opt-arrow {
    font-family: var(--font-mono);
    color: var(--ink-muted);
  }
  .tb-triage__back {
    margin-top: 18px;
    color: var(--ink-muted);
    cursor: pointer;
    background: transparent;
    border: 0;
    padding: var(--space-1) 0;
  }
  .tb-triage__result-label {
    color: var(--accent);
    margin-bottom: var(--space-2);
  }
  .tb-triage__result-head {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }
  .tb-triage__result-body {
    margin: 0 0 20px;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.6;
  }
  .tb-triage__result-actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>

<script is:inline>
  (function () {
    var TREE = {
      start: {
        q: "What's the heart of your dispute?",
        opts: [
          { label: "Defective item", go: "defective" },
          { label: "Wrong / damaged / missing", go: "wrong" },
          { label: "Wrong product entirely (substitution)", go: "substitution" },
          { label: "I changed my mind", go: "mind" },
          { label: "Recalled product", go: "recall" },
          { label: "Refund / credit dispute", go: "refund" },
          { label: "Order cancelled, late or never arrived", go: "cancel" },
          { label: "Sale price or Black Friday deal", go: "deal" },
          { label: "Return refused on a technicality", go: "refused" },
          { label: "Something else", go: "other" },
        ],
      },
      defective: {
        q: "When was it delivered?",
        opts: [
          { label: "Less than 6 months ago", go: "defective6" },
          { label: "More than 6 months ago", result: { clause: "07", tpl: "T13", note: "Past the s 56 return window. CPA s 55(2)(c) still requires goods to be usable and durable for a reasonable period, with no 6-month cap. If the warranty Takealot advertised turns out not to exist or not to be as described, s 41 adds a misrepresentation angle. Use T13 where a warranty was advertised, and pursue the manufacturer in parallel. The common-law aedilitian remedies may also apply (see the Aedilitian remedies page)." } },
        ],
      },
      defective6: {
        q: "Which fits best?",
        opts: [
          { label: "An ordinary defect", result: { clause: "01", tpl: "T01", note: "CPA s 56(2): return it within 6 months of delivery and you elect repair, replacement or refund. The retailer is liable regardless of the manufacturer." } },
          { label: "It's a data-storage device", result: { clause: "04", tpl: "T04", note: "Back up, sign out of your accounts (so no activation lock remains) and factory-reset it yourself. Refuse live credentials: POPIA says processing must be adequate, relevant and not excessive. This route relies on CPA s 56, which runs for 6 months from delivery." } },
          { label: "It's part of a bundle", result: { clause: "05", tpl: "T05", note: "CPA s 56 + s 53(1)(a): a defect in one independently replaceable part doesn't make the working parts defective, so ask for that part to be repaired or replaced. Want your money back instead? A refund is arguably of the bundle price, so expect to return the whole bundle (T06). This route relies on CPA s 56, which runs for 6 months from delivery." } },
        ],
      },
      wrong: {
        q: "Which one?",
        opts: [
          { label: "Wrong item / damaged on delivery", result: { clause: "01", tpl: "T01", note: "Log it within Takealot's 30 days if you can, and refuse it at the door if it's obviously wrong or damaged. If it arrived damaged or doesn't work, CPA s 56 still gives you 6 months from delivery: Takealot's 30-day window can't cut that down (Clause 01). If what arrived is a completely different product, go back and choose 'Wrong product entirely' (T17)." } },
          { label: "Missing part of a set", result: { clause: "01", tpl: "T01", note: "Missing parts is one of Takealot's own 30-day return grounds. Report it in writing the day it arrives (Takealot has told the press missing components must be reported immediately on receipt; its returns policy allows 30 days) and log it as 'missing parts'." } },
          { label: "Says delivered, never arrived", result: { clause: "18", tpl: "T23", note: "GPS shows where the driver was, not who got the parcel. Ask now, in writing, for signed proof of delivery (T23's bracketed paragraph), and send T22 at the same time: it asks, under POPIA s 23, for the delivery record and other records Takealot holds about your order. Once 30 days have passed since you ordered, or an agreed delivery date has passed, T23 also gives 7 days' written notice under ECT s 46(2), after which you can cancel for a full refund. Use T14 only once Takealot has refused." } },
          { label: "An item is missing from the delivery", result: { clause: "06", tpl: "T20", note: "Report it within 30 days of delivery. Takealot's own Help Centre asks you to choose credit, refund or replacement. Choose the refund in writing, and don't accept account credit in its place." } },
          { label: "I sent the wrong item back by mistake", result: { clause: "18", note: "Tell Takealot in writing straight away, with the order number, what you sent and any serial number: its policy says it disposes of incorrect returns and won't pay for lost items. On our own reading, CPA s 65(2) says a supplier holding your property must look after it and is liable for its loss, and the 'won't pay' term is open to challenge under s 48." } },
        ],
      },
      substitution: {
        q: "What did you receive?",
        opts: [
          { label: "A materially different product (e.g. you ordered a phone and got a calculator)", result: { clause: "21", tpl: "T17", note: "Non-performance of the sale (and ECT s 46). This is restitution, not a return: don't accept procedural refusals on accessories or packaging." } },
          { label: "Right product, wrong variant (size/colour)", result: { clause: "01", tpl: "T01", note: "If Takealot sent the wrong size or colour, that's a wrong-item delivery, not a change of mind: log it as 'Not What I Ordered' within Takealot's 30 days, and refuse it at the door if you can. If you ordered the wrong size yourself, ECT s 44 gives you 7 days from receiving it, and Takealot's own change-of-mind window is 30 days (unused, in original packaging)." } },
        ],
      },
      mind: {
        q: "When did you receive it?",
        opts: [
          { label: "Within the last 7 days", result: { clause: "01", tpl: "T01", note: "ECT s 44: you can cancel most online purchases within 7 days of receiving them, without giving a reason. The law allows no charge other than the direct cost of returning the goods, and Takealot's returns policy says \"Our returns are free!\". The refund is due within 30 days of cancelling (s 44(3)), and you can insist on a refund rather than credit. s 42(2) excludes some items, e.g. food, personalised items, books and unsealed software. Choose the cooling-off option in T01." } },
          { label: "8 to 30 days ago", result: { clause: "01", tpl: "T01", note: "Past the ECT 7 days, so this is Takealot's own 30-day change-of-mind policy: unused, in its original product packaging with all its parts, and not on the non-returnable list. Choose the change-of-mind option in T01." } },
          { label: "More than 30 days ago", result: { clause: "01", note: "Neither the ECT 7 days nor Takealot's 30-day window covers a change of mind this late, and we know of no other right to return it. If the item is defective, go back and choose 'Defective item': CPA s 56 runs for 6 months from delivery." } },
        ],
      },
      recall: {
        q: "What's Takealot's response?",
        opts: [
          { label: "Refund refused: \"warranty has expired\"", result: { clause: "22", tpl: "T18", note: "The recall notice is your refund route (e.g. 'return them to a point of purchase for a refund'). Within 6 months of delivery s 56(2) adds the refund election. Warranty expiry answers neither." } },
          { label: "Short-validity coupon issued instead of a refund", result: { clause: "22", tpl: "T18", note: "A two-day coupon isn't a refund. Ask for the money back to the way you paid. If you originally paid with a coupon, ask for a money-equivalent credit valid for Takealot's standard 3 years: a reasonable ask rather than a statutory right." } },
          { label: "Punted to the manufacturer", result: { clause: "22", tpl: "T18", note: "Recall notices usually send you back to where you bought it, and that's Takealot (e.g. 'return them to a point of purchase for a refund'). s 56(1) makes the retailer a warrantor alongside the manufacturer, and within 6 months of delivery s 56(2) also lets you return it for a refund. If the product caused harm, s 61 liability is joint and several." } },
          { label: "I haven't asked yet, or Takealot hasn't answered", result: { clause: "22", tpl: "T18", note: "Ask Takealot in writing for the refund the recall notice provides for, quoting the notice (e.g. 'return them to a point of purchase for a refund'). T18 works as a first letter: leave out the paragraph about Takealot's response. Within 6 months of delivery s 56(2) also lets you return it for a refund." } },
        ],
      },
      refund: {
        q: "What's the issue?",
        opts: [
          { label: "Credit instead of a refund on a defective return", result: { clause: "06", tpl: "T06", note: "If the item was defective, CPA s 56(2) lets you direct the remedy, and credit isn't one of the statutory options unless you agree to it. Takealot's own returns policy also lets you choose a refund. Ask in writing for the refund to go back the way you paid." } },
          { label: "Order cancelled and the money came back as credit", result: { clause: "06", tpl: "T06", note: "Takealot's own terms say \"If an order or item is cancelled, we will refund you the amount paid for that cancelled order or item.\" If the reason was stock, ECT s 46(3) also requires the refund within 30 days of Takealot telling you. Ask in writing for the refund back the way you paid, not credit (T06, 'Order cancelled by Takealot' option). If you also dispute the cancellation itself, use T10." } },
          { label: "Missing item credited instead of refunded", result: { clause: "06", tpl: "T20", note: "Takealot's Help Centre asks you to choose credit, refund or replacement for a missing item. Choose the refund in writing, and ask for any credit already loaded to be reversed and refunded." } },
          { label: "Paid with a voucher, got non-refundable credit back", result: { clause: "11", note: "Takealot's policy loads a voucher's value as non-refundable credit when you return or cancel. If one item in a voucher-paid order was cancelled for stock, the NCC and CGSO's 2025 note says the voucher's full value must go to the rest of that order, not into credit for later: ask for that in writing. A voucher you paid for can't expire within 3 years of issue (CPA s 63)." } },
          { label: "Refund not processed", result: { clause: "06", tpl: "T14", note: "Final notice (T14), plus a card chargeback in parallel if you paid by card." } },
        ],
      },
      cancel: {
        q: "What happened to the order?",
        opts: [
          { label: "Pricing error", result: { clause: "14", tpl: "T10", note: "Once you've paid and received an order confirmation, there's a contract at the confirmed price. A pricing-error cancellation is attackable under s 48 + Reg 44(3)(k); see CGSO Advisory Note 10 (now under CGSO review). That fails if the price was so far off that you ought to have realised it was a mistake. Claim the difference if you re-bought." } },
          { label: "Out of stock", result: { clause: "14", tpl: "T10", note: "Where CPA s 47 applies, s 47(3) requires a refund with interest, plus costs directly incidental to the breach unless the shortage was beyond Takealot's control and it took reasonable steps to tell you as soon as practicable (s 47(5)). ECT s 46(3) requires the refund within 30 days of Takealot telling you the item is unavailable. Ask for it back the way you paid, not as credit." } },
          { label: "Late / silent non-delivery", result: { clause: "14", tpl: "T23", note: "ECT s 46: Takealot must deliver within 30 days or by the date it agreed. Takealot's terms call its delivery dates estimates, so count the 30 days from your order. If it misses that, give 7 days' written notice (T23), then cancel and demand your money back (s 46(3)'s 30-day refund deadline applies if Takealot says the item is unavailable). Your contract is with Takealot, not the courier." } },
          { label: "Tracking says delivered, but I never got it", result: { clause: "18", tpl: "T23", note: "GPS shows where the driver was, not who got the parcel. Ask now, in writing, for signed proof of delivery (T23's bracketed paragraph), and send T22 at the same time: it asks, under POPIA s 23, for the delivery record and other records Takealot holds about your order. Once 30 days have passed since you ordered, or an agreed delivery date has passed, T23 also gives 7 days' written notice under ECT s 46(2), after which you can cancel for a full refund. Use T14 only once Takealot has refused." } },
          { label: "Paid for faster delivery and it came late", result: { clause: "14", tpl: "T19", note: "CPA s 54: delivery you paid for separately is a service. Ask for the premium back as a refund, not account credit. If the order still hasn't arrived, send T23 as well." } },
          { label: "Charged for a paid delivery option I didn't choose", result: { clause: "14", note: "EWN reported in September 2026 that faster paid delivery could be pre-selected at Takealot checkout. If you were charged for a paid option you didn't actively choose, CPA s 31 arguably makes that charge void. This rests on a press report we haven't checked ourselves, and no court or regulator has applied s 31 to a checkout default yet. Ask Takealot in writing for the fee back." } },
          { label: "I cancelled, and Takealot kept the delivery fee", result: { clause: "01", tpl: "T01", note: "Takealot's Help Centre says delivery fees aren't reimbursed if you cancel an order that's already being fulfilled. Our own reading, not a ruling: ECT s 44 allows no charge other than the direct cost of returning the goods, so keeping the delivery fee is a charge it doesn't allow. It fits most cleanly once the order has arrived: accept it, keep it unopened, log a return within 7 days (T01, cooling-off option) and ask in writing for a full refund, delivery fee included, under s 44(3). See the FAQ on delivery fees." } },
          { label: "Cancelled, then relisted at a higher price", result: { clause: "23", tpl: "T10", note: "Screenshot the new listing (seller, price, date). Ask Takealot in writing why the item was treated as unavailable, using T10's bracketed relisting paragraph, and insist on the confirmed price or a refund to the way you paid. A different seller relisting it can be genuine." } },
          { label: "Other reason", result: { clause: "14", tpl: "T10", note: "Once you've paid and received an order confirmation, there's a contract. Seek a refund to the way you paid, plus the difference if you had to buy elsewhere." } },
        ],
      },
      deal: {
        q: "What happened?",
        opts: [
          { label: "The \"was\" price looks fake", result: { clause: "23", note: "A \"was\" price the item never really sold at is misleading pricing under CPA s 29(b)(iii), and falsely implying a saving is a misleading representation under s 41(3)(f). Screenshot the listing with the date showing and report it to the NCC, or to the Advertising Regulatory Board about the advert. If you've already bought it, ECT s 44 lets you cancel within 7 days of receiving it." } },
          { label: "The deal sold out, or the price changed, before I paid", result: { clause: "23", note: "Until you've paid and received an order confirmation, Takealot's terms say the order isn't complete, so there's usually nothing to enforce. If the deal was advertised with almost no stock behind it, that may be bait marketing (CPA s 30): screenshot it and report it to the NCC." } },
          { label: "I paid, then it was cancelled and relisted for more", result: { clause: "23", tpl: "T10", note: "Screenshot the new listing (seller, price, date). Ask Takealot in writing why the item was treated as unavailable, using T10's bracketed relisting paragraph, and insist on the confirmed price or a refund to the way you paid. A different seller relisting it can be genuine." } },
        ],
      },
      refused: {
        q: "On what basis?",
        opts: [
          { label: "No original packaging", result: { clause: "02", tpl: "T02", note: "If the item is defective, s 56 doesn't require original packaging, and s 51(3) voids a term that waives that right (T02). On any return, the 'original packaging' is the product's box, not Takealot's brown delivery box: Takealot has publicly said it doesn't expect that back." } },
          { label: "Defective item refused for \"wear and tear\" / consumer damage / surge / sea air / misuse", result: { clause: "08", tpl: "T03", note: "Takealot has to prove the exclusion it relies on (Toyota Randburg 2024, relied on in Edan Traders 2026; Wingfield 2025). Demand the technical report." } },
          { label: "Not accepted as damaged on delivery (\"you damaged it\" / surge / misuse)", result: { clause: "03", tpl: "T03", note: "Takealot has to prove the damage was your doing (Toyota Randburg 2024, relied on in Edan Traders 2026). Demand the technical report. If the item arrived damaged or doesn't work, CPA s 56 still runs for 6 months from delivery." } },
          { label: "Marked \"non-returnable\"", result: { clause: "10", tpl: "T01", note: "The s 42(2) carve-outs only remove the 7-day cooling-off. A defective item is still a s 56 return, and a \"non-returnable\" or \"non-refundable\" tag on an item outside s 42(2) doesn't remove the 7 days either." } },
          { label: "Deflected to manufacturer", result: { clause: "07", tpl: "T07", note: "s 56(1) makes the retailer a warrantor alongside the manufacturer, so Takealot can't hand you off. T07 is for the first 6 months after delivery; after that, use T13." } },
          { label: "\"You bought it to resell\"", result: { clause: "17", note: "Why you bought an item isn't a ground for refusing a CPA s 56 defective return. If Takealot cites its resale clause to refuse one, push back in writing and refer to s 56." } },
          { label: "Marketplace seller's fault", result: { clause: "15", tpl: "T11", note: "The NCC and CGSO say the platform must resolve the dispute and make sure its sellers comply with the CPA and ECT Act. The CGSO takes complaints against Takealot for other-seller items." } },
          { label: "Charged a collection or re-delivery fee on a return", result: { clause: "19", tpl: "T15", note: "On a defective return, CPA s 56(2) puts the return at the supplier's risk and expense: don't pay the fee, and challenge it (T15). Inside the 7-day ECT cooling-off, the only charge allowed is the direct cost of returning the goods (s 44(2)). On an ordinary change-of-mind return outside those 7 days, Takealot's own terms apply." } },
          { label: "Inspection is dragging with no deadline", result: { clause: "20", tpl: "T16", note: "Policy has no SLA on inspection. Set your own written deadline (7 business days) and escalate to the CGSO if there's no answer by then. T16 is for a return within 6 months of delivery; for an extended-warranty evaluation after that, see Clause 07." } },
        ],
      },
      other: {
        q: "What category?",
        opts: [
          { label: "Digital item doesn't work", result: { clause: "16", tpl: "T12", note: "Defective digital items are still defective goods: CPA s 56 applies for 6 months from delivery. Never delivered at all? T12 has a paragraph for that." } },
          { label: "Policy changed after my order", result: { clause: "12", tpl: "T09", note: "The applicable version is the version at order time." } },
          { label: "Disposal threat", result: { clause: "09", tpl: "T08", note: "Dispute the rejection in writing before day 30 and file with the CGSO. Either ask Takealot to keep the item and confirm that in writing, or accept re-delivery under protest: the policy treats a refused re-delivery as abandonment." } },
          { label: "High Court clause", result: { clause: "13", tpl: "T14", note: "s 48 / Reg 44 / s 51(3) attack the forum clause. You keep your Small Claims option." } },
          { label: "Inspection / assessment delay", result: { clause: "20", tpl: "T16", note: "Demand a written outcome within 7 business days, and escalate to the CGSO if there's no answer by then. T16 is for a return within 6 months of delivery; for an extended-warranty evaluation after that, see Clause 07." } },
          { label: "Account closed with credit on it", result: { clause: "24", tpl: "T21", note: "Refund credit came from money you paid. Ask in writing for the balance to be paid to your bank account, and for the reason for the closure." } },
          { label: "Someone took over my account", result: { clause: "24", tpl: "T22", note: "Report it to Takealot in writing the same day, change your Takealot and email passwords, remove saved cards, and ask your bank to block the card and dispute fraudulent transactions. Takealot's terms put the risk of account fraud on you, but that term is arguably presumed unfair (Reg 44(3)(g)), and where Takealot was grossly negligent CPA s 51(1)(c)(ii) makes it void. T22 asks for the records Takealot holds about your account." } },
        ],
      },
    };

    // Slug map is sourced from CLAUSES[] at server-render time and embedded
    // as JSON above (#tb-clause-slugs) — no hand-maintained duplicate.
    var slugEl = document.getElementById('tb-clause-slugs');
    var CLAUSE_SLUGS = slugEl ? JSON.parse(slugEl.textContent || '{}') : {};

    var dialog = document.querySelector('[data-triage]');
    if (!dialog) return;
    var body = dialog.querySelector('[data-triage-body]');
    var state = { node: 'start', result: null };

    function esc(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      });
    }

    function render() {
      if (state.result) {
        body.innerHTML =
          '<div class="mono tb-triage__result-label">/ Result</div>' +
          '<div class="tb-triage__result-head">Clause ' + esc(state.result.clause) + (state.result.tpl ? ' · Template ' + esc(state.result.tpl) : '') + '</div>' +
          '<p class="tb-triage__result-body">' + esc(state.result.note) + '</p>' +
          '<div class="tb-triage__result-actions">' +
            '<button type="button" class="btn primary" data-triage-openclause="' + esc(state.result.clause) + '">Open clause &rarr;</button>' +
            // Some results have no template (e.g. a fake "was" price is a
            // report to the NCC, not a letter to Takealot).
            (state.result.tpl ? '<button type="button" class="btn" data-triage-opentpl="' + esc(state.result.tpl) + '">Open template &rarr;</button>' : '') +
            '<button type="button" class="btn ghost" data-triage-restart>Start over</button>' +
          '</div>';
        return;
      }
      var cur = TREE[state.node] || TREE.start;
      var html =
        '<div class="tb-triage__q">' + esc(cur.q) + '</div>' +
        '<div class="tb-triage__opts">' +
          cur.opts.map(function (o, i) {
            var meta = o.result
              ? (' data-triage-result="' + i + '"')
              : (' data-triage-go="' + esc(o.go) + '"');
            return '<button type="button" class="tb-triage__opt"' + meta + '>' +
                   '<span>' + esc(o.label) + '</span>' +
                   '<span class="tb-triage__opt-arrow">&rarr;</span>' +
                   '</button>';
          }).join('') +
        '</div>';
      if (state.node !== 'start') {
        html += '<button type="button" class="mono tb-triage__back" data-triage-restart>&larr; Start over</button>';
      }
      body.innerHTML = html;

      // Store the current node's opts so we can resolve result indices on click.
      body.__tbOpts = cur.opts;
    }

    var lastFocused = null;
    function open() {
      lastFocused = document.activeElement;
      state = { node: 'start', result: null };
      render();
      if (typeof dialog.showModal === 'function') {
        if (!dialog.open) dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      // Native <dialog> autofocus picks the first focusable child only when
      // showModal() runs after content exists — render() did, but be explicit
      // so keyboard users land on the first option, not nothing.
      var firstOpt = body.querySelector('.tb-triage__opt');
      if (firstOpt && typeof firstOpt.focus === 'function') firstOpt.focus();
    }
    function close() {
      if (typeof dialog.close === 'function' && dialog.open) dialog.close();
      else dialog.removeAttribute('open');
      // Return focus to whatever triggered the modal (typically a Header CTA).
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
    }
    function toggle() { dialog.open ? close() : open(); }

    // External triggers
    window.addEventListener('tb:triage-toggle', toggle);
    window.addEventListener('tb:triage-close', close);

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;
      if (t.closest('[data-triage-open]')) { open(); return; }
      if (t.closest('[data-triage-close]')) { close(); return; }
    });

    // Backdrop click closes.
    dialog.addEventListener('click', function (e) {
      if (e.target === dialog) close();
    });

    // Body delegated click handlers (go / result / restart / open clause / open tpl).
    body.addEventListener('click', function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;
      var btn = t.closest('button');
      if (!btn) return;

      if (btn.hasAttribute('data-triage-restart')) {
        state = { node: 'start', result: null };
        render();
        return;
      }
      var go = btn.getAttribute('data-triage-go');
      if (go) { state.node = go; render(); return; }
      var resultIdx = btn.getAttribute('data-triage-result');
      if (resultIdx !== null) {
        var opt = body.__tbOpts && body.__tbOpts[parseInt(resultIdx, 10)];
        if (opt && opt.result) { state.result = opt.result; render(); }
        return;
      }
      var openClause = btn.getAttribute('data-triage-openclause');
      if (openClause) {
        var slug = CLAUSE_SLUGS[openClause];
        close();
        if (slug && location.pathname === '/') {
          var el = document.getElementById('clause-' + slug);
          if (el) {
            var ctoggle = el.querySelector('[data-toggle]');
            if (ctoggle && ctoggle.getAttribute('aria-expanded') !== 'true') ctoggle.click();
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } else if (slug) {
          location.href = '/#clause-' + slug;
        }
        return;
      }
      var openTpl = btn.getAttribute('data-triage-opentpl');
      if (openTpl) {
        close();
        if (location.pathname === '/') {
          var te = document.getElementById('template-' + openTpl);
          if (te) {
            var ttoggle = te.querySelector('[data-tpl-toggle]');
            if (ttoggle && ttoggle.getAttribute('aria-expanded') !== 'true') ttoggle.click();
            te.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        } else {
          location.href = '/#template-' + openTpl;
        }
      }
    });

    // The native <dialog> handles Escape itself; also listen for the global close event.
    dialog.addEventListener('cancel', function () { /* default: close */ });
  })();
</script>
